# LiaraPilot configuration.
# Every value here can ALSO be set in the panel (Admin -> تنظیمات و اتصال‌ها).
# A value saved in the panel wins; clearing it there falls back to this file.

# --- Liara (PaaS) ---------------------------------------------------------
# API token: Liara console -> API. Required.
LIARA_API_TOKEN=
# Team ID if the apps belong to a team (leave empty for a personal account)
LIARA_TEAM_ID=
# API base URL (default shown)
LIARA_API_BASE=https://api.iran.liara.ir

# --- AI provider (any OpenAI-compatible chat-completions endpoint) ----------
# Examples:
#   DeepSeek   https://api.deepseek.com            deepseek-chat
#   OpenAI     https://api.openai.com/v1           gpt-4o-mini
#   Anthropic  https://api.anthropic.com/v1        claude-haiku-4-5
#   OpenRouter https://openrouter.ai/api/v1        openai/gpt-4o-mini
#   Groq       https://api.groq.com/openai/v1      llama-3.3-70b-versatile
#   Ollama     http://localhost:11434/v1           llama3.1
AI_LABEL=DeepSeek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=

# --- Optional: local project detection (see scripts/install-railpack.sh) ---
# RAILPACK_BIN=/path/to/railpack
